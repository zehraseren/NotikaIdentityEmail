@model List<RoleAssignViewModel>

@{
    ViewData["Title"] = "AssignRole";
    Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="form-element-list">
                <div class="basic-tb-hd">
                    <h2>Kullanıcı Rol Atama</h2>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="list-group list-group-flush mb-4">
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <div class="form-check list-group-item">
                                    <input type="hidden" asp-for="@Model[i].RoleId" />
                                    <input type="hidden" asp-for="@Model[i].RoleName" />
                                    <input class="form-check-input" type="checkbox" asp-for="@Model[i].RoleExist" id="roleCheck_@i" />
                                    <label class="form-check-label" for="roleCheck_@i">@Model[i].RoleName</label>
                                </div>
                            }
                        </div>
                        <button type="submit" class="btn btn-info">Kaydet</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
